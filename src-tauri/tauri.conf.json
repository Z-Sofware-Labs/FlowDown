{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowDown",
  "mainBinaryName": "flowdown",
  "version": "2.0.7",
  "identifier": "com.flowdown.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "FlowDown 2.0.7",
        "width": 1280,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "backgroundColor": "#202020",
        "theme": "Dark",
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Z Software Labs",
    "copyright": "Copyright © 2026 Z Software Labs",
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "fileAssociations": [
      {
        "ext": ["torrent"],
        "name": "BitTorrent Metainfo File",
        "description": "BitTorrent Metainfo File",
        "role": "Viewer",
        "mimeType": "application/x-bittorrent"
      }
    ],
    "resources": [
      "icons/magnet.ico",
      "icons/torrent.ico",
      "icons/magnet-link.ico",
      "icons/torrent-file.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerHooks": "./windows/hooks.nsi",
        "template": "./windows/installer.nsi"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1OTRCQTAzODFCOTcxMkIKUldRcmNibUJBN3FVTlZTSzdYSDhBV0RNaVk3UEFFWGF0YjBxSFRuYURJR0NmQmRTU2M4K2JaUUoK",
      "endpoints": [
        "https://github.com/Z-Sofware-Labs/FlowDown/releases/latest/download/latest.json"
      ]
    }
  }
}
