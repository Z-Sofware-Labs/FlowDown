{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FlowDown",
  "version": "1.0.3",
  "identifier": "com.flowdown.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FlowDown Download Manager",
        "width": 1100,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "publisher": "Z Software Labs",
    "copyright": "Copyright © 2026 Z Software Labs. All rights reserved.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/magnet.ico": "magnet.ico",
      "icons/torrent.ico": "torrent.ico"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsi",
        "template": "./windows/installer.nsi"
      }
    },
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/flowdown.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/flowdown.desktop"
      }
    }
  },
  "mainBinaryName": "flowdown",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM1OTRCQTAzODFCOTcxMkIKUldRcmNibUJBN3FVTlZTSzdYSDhBV0RNaVk3UEFFWGF0YjBxSFRuYURJR0NmQmRTU2M4K2JaUUoK",
      "endpoints": [
        "https://github.com/Z-Sofware-Labs/FlowDown/releases/latest/download/latest.json"
      ]
    }
  }
}
