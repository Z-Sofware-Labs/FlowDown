      "icons/magnet.ico": "magnet.ico",
      "icons/torrent.ico": "torrent.ico",
      "icons/magnet.icns": "magnet.icns",
      "icons/torrent.icns": "torrent.icns"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/hooks.nsi",
